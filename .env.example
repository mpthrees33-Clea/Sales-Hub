# ── Core (required) ──────────────────────────────────────────────────────────
# Postgres connection string. Neon in production; any Postgres 15+ locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales_hub
# Vercel AI Gateway key. When absent, the harness runs the deterministic demo
# model (scenario-scripted outputs) so the whole hub works offline.
AI_GATEWAY_API_KEY=
# Direct Anthropic API key. When set (and live mode is on), the nightly triage
# sweep runs through the Message Batches API at 50% token cost; when absent it
# falls back to serial per-email gateway calls.
ANTHROPIC_API_KEY=
# Vercel Blob read-write token. When absent, blobs are stored on the local
# filesystem under var/blob and served from /api/blob/<key>.
BLOB_READ_WRITE_TOKEN=
# Demo mode: seeded providers, demo clock, fictional data. Keep true for the demo.
DEMO_MODE=true
# Min 32 chars; signs the clea_session cookie (HMAC-SHA256).
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# The single demo login password (rep persona: Cole Mercer).
DEMO_LOGIN_PASSWORD=clea-demo

# ── Optional live providers (unused in demo mode) ────────────────────────────
# AssemblyAI (diarized transcription) — live TranscriptionProvider.
ASSEMBLYAI_API_KEY=
# Google Routes API — live MapsProvider (computeRoutes; never the legacy Directions API).
GOOGLE_MAPS_API_KEY=
# Gemini image model — live ImageGenProvider (room scenes).
GEMINI_API_KEY=
# Keep live room-scene generation on inside demo mode (the one intentionally-live wow).
SCENES_LIVE_IN_DEMO=true
# Shared secret protecting /api/cron/nightly outside Vercel (Vercel cron sends its own signature).
CRON_SECRET=

# ── Microsoft Graph (documented production path — not wired in the demo) ─────
# Entra app registration for Outlook/M365: delegated Mail.Read, Mail.ReadWrite,
# Calendars.Read. The EmailProvider/CalendarProvider interfaces are Graph-shaped
# so GraphEmailProvider is a drop-in. See docs/APPENDIX-recommendations.md §4.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
